# 运行模式：development、test、production
FL_ENVIRONMENT=development

# 本机开发默认只监听回环地址；容器内由 compose 覆盖为 0.0.0.0。
FL_HOST=127.0.0.1
FL_PORT=8000

# 必须是 JSON 数组；不允许 "*"，也不允许带路径、查询或片段。
FL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 导入任务只写入本机已忽略目录。相对路径按仓库根目录解析。
FL_IMPORT_ROOT=data/local/imports
FL_ANALYTICS_DATABASE=data/local/analytics.duckdb
FL_CONTROL_DATABASE=data/local/control.sqlite3

# 安全与资源上限；生产使用更大值前应先完成阶段 10 性能测试。
FL_MAX_UPLOAD_BYTES=10485760
FL_MAX_XLSX_UNCOMPRESSED_BYTES=52428800
FL_MAX_XLSX_ENTRIES=512
FL_MAX_IMPORT_ROWS=50000
FL_MAX_IMPORT_COLUMNS=200
FL_MAX_CELL_CHARS=4096
FL_IMPORT_TASK_TTL_HOURS=24

# 单个 Markdown、HTML 或 CSV 导出结果的最大内存大小（默认 50 MiB）。
FL_MAX_EXPORT_BYTES=52428800
