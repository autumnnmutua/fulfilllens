{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fulfilllens.cn/schemas/warehouse-event.schema.json",
  "title": "FulfillLens 仓库事件行",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "order_id",
    "event_time",
    "event_code",
    "raw_status",
    "warehouse_id"
  ],
  "dependentRequired": {
    "quantity": [
      "quantity_unit"
    ],
    "quantity_unit": [
      "quantity"
    ]
  },
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "event_code": {
      "$ref": "https://fulfilllens.cn/schemas/status-codes.schema.json#/$defs/warehouseEventCode"
    },
    "raw_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "warehouse_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "quantity": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "quantity_unit": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 32
    },
    "source_system": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    }
  }
}
