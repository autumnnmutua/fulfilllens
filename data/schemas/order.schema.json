{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fulfilllens.cn/schemas/order.schema.json",
  "title": "FulfillLens 订单行",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "created_at",
    "ordered_quantity",
    "quantity_unit",
    "order_status",
    "raw_order_status"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "promised_delivery_time": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "actual_delivery_time": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ordered_quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "delivered_quantity": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "quantity_unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "order_status": {
      "$ref": "https://fulfilllens.cn/schemas/status-codes.schema.json#/$defs/orderStatus"
    },
    "raw_order_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "warehouse_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "carrier_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "destination_region": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "sales_channel": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    }
  }
}
