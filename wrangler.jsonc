{
  "name": "fulfilllens",
  "main": "apps/cloudflare-worker/src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
}
